# ─── Development (local network backend) ───────────────────────────────────
# Empty: the app calls its own address and `npm run dev` forwards /api and /uploads to DEV_API_PROXY_TARGET
# (vite.config.js), so the backend's CORS rules never apply. Set a full address here only to call a backend
# directly, and then that backend must allow http://localhost:5173.
VITE_API_BASE_URL=
DEV_API_PROXY_TARGET=http://102.68.87.231:8090
VITE_SWAGGER_URL=http://102.68.87.231:8090/swagger-ui/index.html

# ─── Features that are built but off by default ────────────────────────────
# Verify accounts by a code sent on WhatsApp (register choice + verify page). Hidden for now.
VITE_ENABLE_WHATSAPP_VERIFICATION=false

# ─── Google sign-in ────────────────────────────────────────────────────────
# "Continue with Google" on the log-in and register pages. Leave empty to hide it. Needs the backend's POST /auth/google.
# Create an OAuth client (type: Web application) in Google Cloud Console and add every address this site is served from
# (e.g. http://localhost:5173 and the live https address) under "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=353452894856-d9tudsttmmma590akjuetpap5na22vs9.apps.googleusercontent.com

# ─── Pesapal ────────────────────────────────────────────────────────────────
# sandbox | live
VITE_PESAPAL_ENV=sandbox
