# The VPS build (`npm run build`). Loaded on top of .env.
# The API is the site's own https address: the host Nginx forwards /api and /uploads to the backend (deploy/nginx),
# and redirects http and www to this address, so the page and its API always share one origin. Not
# http://102.68.87.231:8090 directly — the live site is https, and browsers block an https page from calling http.
# The CI build sets these again (.github/workflows/frontend-build.yml) — keep the two in step.
VITE_API_BASE_URL=https://ramellianexecutivetravels.co.ke
VITE_SWAGGER_URL=http://102.68.87.231:8090/swagger-ui/index.html
