# Local development (`npm run dev`) — the backend on the office network. Loaded on top of .env.
# The browser calls it directly (it allows http://localhost:5173 — keep the dev server on that port).
# Empty VITE_API_BASE_URL instead would go through the dev proxy below, which works on any port.
VITE_API_BASE_URL=http://192.168.8.31:8090
DEV_API_PROXY_TARGET=http://192.168.8.31:8090
VITE_SWAGGER_URL=http://192.168.8.31:8090/swagger-ui/index.html
